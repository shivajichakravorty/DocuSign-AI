PORT=3000
DATABASE_URL=postgres://postgres:password@localhost:5432/docushield
JWT_SECRET=your_jwt_secret_here
COOKIE_SECRET=your_cookie_secret_here
FRONTEND_URL=http://localhost:5173
STORAGE_DRIVER=local # switch to 's3' when S3/R2 credentials are configured
AWS_REGION=auto
S3_BUCKET=docushield-pdfs
S3_ENDPOINT=https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com # omit or set for AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
